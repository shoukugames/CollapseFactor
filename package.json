{
  "name": "collapse-factor",
  "productName": "Collapse Factor",
  "version": "0.1.0",
  "description": "A physics-based bridge and tower building puzzle game. Build with wood, steel and concrete, then survive real weight and wind.",
  "main": "main.js",
  "homepage": "https://shoukugames.org/",
  "author": {
    "name": "Shawn Rapaz",
    "email": "info@shoukugames.org",
    "url": "https://shoukugames.org/"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "fonts": "node scripts/copy-fonts.js",
    "test:sim": "node scripts/sim-test.js",
    "dist:linux": "electron-builder --linux deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist": "electron-builder --linux deb --win nsis portable"
  },
  "build": {
    "appId": "org.shoukugames.collapsefactor",
    "productName": "Collapse Factor",
    "copyright": "Copyright (C) 2026 Shawn Rapaz - GPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "LICENSE",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Game",
      "icon": "resources/icons",
      "synopsis": "Physics bridge & tower building puzzle game",
      "maintainer": "Shawn Rapaz <info@shoukugames.org>",
      "vendor": "Shouku Games"
    },
    "deb": {
      "packageCategory": "games"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "CollapseFactor-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CollapseFactor-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
